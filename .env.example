# Points the frontend at the backend API. Must include /api/v1.
# Set this explicitly in Vercel — don't rely on the code's fallback default.
VITE_API_BASE_URL=https://frental-backend-prod.onrender.com/api/v1

# Optional. Error tracking via Sentry — leave unset to disable entirely
# (contributes zero bytes to the build when unset). Build-time var: set in
# Vercel and redeploy, changing it at runtime has no effect.
# VITE_SENTRY_DSN=
